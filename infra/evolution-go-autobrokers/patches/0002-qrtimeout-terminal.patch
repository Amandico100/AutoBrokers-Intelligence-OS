index fa43c94..bdc6b6f 100644
--- a/pkg/instance/service/instance_service.go
+++ b/pkg/instance/service/instance_service.go
@@ -90,8 +90,10 @@ type StatusStruct struct {
 }
 
 type QrcodeStruct struct {
-	Qrcode string `json:"qrcode"`
-	Code   string `json:"code"`
+	Qrcode   string `json:"qrcode"`
+	Code     string `json:"code"`
+	State    string `json:"state,omitempty"`
+	ErrorCode string `json:"errorCode,omitempty"`
 	// Passkey ceremony fields. Populated when the account requires a WebAuthn
 	// passkey to finish linking (no QR to scan at that point). The manager uses
 	// PasskeyStage to switch its UI and PasskeyOpenUrl for the
@@ -234,6 +236,8 @@ func (i instances) Connect(data *ConnectStruct, instance *instance_model.Instanc
 	instance.RabbitmqEnable = data.RabbitmqEnable
 	instance.NatsEnable = data.NatsEnable
 	instance.WebSocketEnable = data.WebSocketEnable
+	// Connect is the explicit retry boundary after terminal pairing states.
+	instance.DisconnectReason = ""
 
 	err := i.instanceRepository.Update(instance)
 	if err != nil {
@@ -415,13 +419,19 @@ func (i instances) GetQr(instance *instance_model.Instance) (*QrcodeStruct, erro
 	logger := i.loggerWrapper.GetLogger(instance.Id)
 	client := i.clientPointer[instance.Id]
 
-	// Se não há cliente ou o cliente está logado, precisamos iniciar um novo cliente
-	if client == nil || client.IsLoggedIn() {
-		if client != nil && client.IsLoggedIn() {
-			logger.LogInfo("[%s] Client is logged in, starting new instance for QR code", instance.Id)
-		} else {
-			logger.LogInfo("[%s] No client found, starting new instance for QR code", instance.Id)
+	if client == nil {
+		if state := normalizedPairingTerminalState(instance.DisconnectReason); state != "" {
+			return &QrcodeStruct{State: state, ErrorCode: state}, nil
 		}
+	}
+	if client != nil && client.IsLoggedIn() {
+		return &QrcodeStruct{State: "connected"}, nil
+	}
+
+	// Starting a missing client is an explicit QR request. A logged-in client is
+	// handled above and is never replaced merely to produce a new QR.
+	if client == nil {
+		logger.LogInfo("[%s] No client found, starting new instance for QR code", instance.Id)
 
 		// Iniciar nova instância para gerar QR code
 		err := i.whatsmeowService.StartInstance(instance.Id)
@@ -478,6 +488,9 @@ func (i instances) GetQr(instance *instance_model.Instance) (*QrcodeStruct, erro
 
 		code = instance.Qrcode
 		if code == "" {
+			if state := normalizedPairingTerminalState(instance.DisconnectReason); state != "" {
+				return &QrcodeStruct{State: state, ErrorCode: state}, nil
+			}
 			return nil, fmt.Errorf("no QR code available. Please wait a moment and try again")
 		}
 	}
@@ -490,11 +503,21 @@ func (i instances) GetQr(instance *instance_model.Instance) (*QrcodeStruct, erro
 	qr := &QrcodeStruct{
 		Qrcode: parts[0],
 		Code:   parts[1],
+		State:  "qr_ready",
 	}
 
 	return qr, nil
 }
 
+func normalizedPairingTerminalState(reason string) string {
+	switch reason {
+	case "qr_expired", "re_pair_required", "db_pool_exhausted", "provider_unavailable":
+		return reason
+	default:
+		return ""
+	}
+}
+
