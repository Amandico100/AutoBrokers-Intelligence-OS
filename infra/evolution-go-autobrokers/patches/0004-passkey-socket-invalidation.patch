+func (mycli *MyClient) invalidatePasskeyCeremony(errorCode, message string) bool {
+	if mycli.passkeyCeremony == nil || !mycli.passkeyCeremony.HasActiveByInstance(mycli.userID) {
+		return false
+	}
+
+	mycli.passkeyCeremony.SetErrorCode(mycli.userID, errorCode, message)
+	mycli.Instance.Connected = false
+	mycli.Instance.DisconnectReason = errorCode
+	if err := mycli.instanceRepository.UpdateConnected(mycli.userID, false, errorCode); err != nil {
+		mycli.loggerWrapper.GetLogger(mycli.userID).LogError("[%s] Failed to persist passkey terminal state: %v", mycli.userID, err)
+	}
+	mycli.loggerWrapper.GetLogger(mycli.userID).LogWarn("[%s] Passkey ceremony invalidated: %s", mycli.userID, errorCode)
+	return true
+}
