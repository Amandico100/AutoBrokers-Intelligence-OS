diff --git a/pkg/passkey/handler/passkey_handler.go b/pkg/passkey/handler/passkey_handler.go
index eff68c7..897a6c7 100644
--- a/pkg/passkey/handler/passkey_handler.go
+++ b/pkg/passkey/handler/passkey_handler.go
@@ -76,6 +76,10 @@ func (h *PasskeyHandler) GetCeremony(c *gin.Context) {
 	if state.Error != "" {
 		resp["error"] = state.Error
 	}
+	if state.ErrorCode != "" {
+		resp["errorCode"] = state.ErrorCode
+	}
+	resp["expiresAt"] = state.ExpiresAt
 	c.JSON(http.StatusOK, resp)
 }
 
@@ -175,9 +179,28 @@ func (h *PasskeyHandler) Confirm(c *gin.Context) {
 func RegisterRoutes(eng *gin.Engine, svc whatsmeow_service.WhatsmeowService) {
 	h := NewPasskeyHandler(svc)
 	grp := eng.Group("/passkey-ceremony")
+	grp.Use(passkeyCORS())
 	{
+		grp.OPTIONS("/*path", func(c *gin.Context) { c.Status(http.StatusNoContent) })
 		grp.GET("/:token", h.GetCeremony)
 		grp.POST("/:token/response", h.SubmitResponse)
 		grp.POST("/:token/confirm", h.Confirm)
 	}
 }
+
+func passkeyCORS() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		// The engine has legacy wildcard CORS for authenticated API routes. The
+		// public passkey bridge is intentionally restricted to WhatsApp Web,
+		// because WebAuthn assertions must be created on that origin.
+		c.Writer.Header().Del("Access-Control-Allow-Origin")
+		c.Writer.Header().Del("Access-Control-Allow-Credentials")
+		c.Writer.Header().Set("Vary", "Origin")
+		if c.GetHeader("Origin") == "https://web.whatsapp.com" {
+			c.Writer.Header().Set("Access-Control-Allow-Origin", "https://web.whatsapp.com")
+			c.Writer.Header().Set("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
+			c.Writer.Header().Set("Access-Control-Allow-Headers", "Content-Type")
+		}
+		c.Next()
+	}
+}
