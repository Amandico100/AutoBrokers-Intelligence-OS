+func positiveIntFromEnv(key string, fallback int) int {
+	raw := strings.TrimSpace(os.Getenv(key))
+	if raw == "" {
+		return fallback
+	}
+
+	value, err := strconv.Atoi(raw)
+	if err != nil || value <= 0 {
+		logger.LogWarn("[CONFIG] %s must be a positive integer; using %d", key, fallback)
+		return fallback
+	}
+	return value
+}
