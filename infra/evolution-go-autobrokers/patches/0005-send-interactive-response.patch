+// InteractiveResponseStruct is the body for POST /send/interactiveResponse.
+//
+// It sends what a WhatsApp CLIENT produces when a person fills in a native flow
+// -- an "app inside WhatsApp" -- and taps submit. Every other /send route
+// ORIGINATES an interactive message; this one ANSWERS one. That asymmetry is
+// the whole reason the route has to exist: whatsmeow has always been able to
+// carry the answer, and the inbound path in pkg/whatsmeow/service already reads
+// exactly these fields. Only the outbound door was missing.
+//
+// This endpoint is deliberately a dumb pipe. ParamsJSON is carried as an opaque
+// string: checked for being valid JSON, then forwarded byte for byte. It is
+// never unmarshalled and re-marshalled, because that reorders keys and
+// re-escapes unicode, and nobody has established which of those the receiving
+// side is sensitive to.
+type InteractiveResponseStruct struct {
+	// Destination phone number.
+	Number string `json:"number" example:"5511999999999"`
+	// Envelope name, ECHOED from the flow message being answered. Values seen in
+	// the field: "galaxy_message" (legacy) and "flow" (current).
+	//
+	// Required, and with no default on purpose. A wrong envelope makes the
+	// receiver drop the answer silently -- no error, no retry, just a form that
+	// was never heard. A default here would be a guess wearing a friendly name.
+	Name string `json:"name" example:"galaxy_message"`
+	// The answer itself, already serialised. Must be valid JSON. Carries the
+	// flow_token and the form fields.
+	ParamsJSON string `json:"paramsJSON"`
+	// Envelope version. Omitted from the wire when 0 -- absent is a fact we can
+	// state, while 1 would be a guess dressed up as a default.
+	Version int32 `json:"version,omitempty" example:"1"`
+	// Optional body text for the chat bubble.
+	Body string `json:"body,omitempty"`
+	// Typing delay (milliseconds) applied before sending.
+	Delay int32 `json:"delay,omitempty" example:"1200"`
+	// If false, skips automatic formatting of `number` into a JID.
+	FormatJid *bool `json:"formatJid,omitempty"`
+	// Quoted (reply-to) context -- normally the flow message being answered.
+	Quoted QuotedStruct `json:"quoted,omitempty"`
+	// Adds the <biz><interactive native_flow/></biz> stanza nodes that
+	// /send/button injects. A person answering a form is not a business sending
+	// an interactive message, so this is OFF by default. It exists as the
+	// documented fallback for the case where a loopback test shows the answer
+	// not landing -- so that discovery costs a flag, not another image build.
+	WithBizNodes bool `json:"withBizNodes,omitempty"`
+}
+
