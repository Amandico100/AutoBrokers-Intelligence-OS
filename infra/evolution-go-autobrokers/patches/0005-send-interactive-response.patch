+// Answer a native flow
+// @Summary Answer a native flow (an "app inside WhatsApp")
+// @Description Sends what a WhatsApp client produces when a person fills in a native flow
+// @Description form and submits it. Every other /send route ORIGINATES an interactive
+// @Description message; this one ANSWERS one.
+// @Description
+// @Description `paramsJSON` is forwarded byte for byte -- validated as JSON, never
+// @Description re-serialised, so key order and escaping survive intact.
+// @Description
+// @Description `name` is the envelope of the flow being answered and has NO default: echo
+// @Description it from the message you are replying to. Values seen in the field are
+// @Description `galaxy_message` (legacy) and `flow` (current). A wrong envelope makes the
+// @Description receiver drop the answer silently -- there is no error to catch.
+// @Description
+// @Description Required body fields: `number`, `name`, `paramsJSON`.
+// @Tags Send Message
+// @Accept json
+// @Produce json
+// @Param message body send_service.InteractiveResponseStruct true "Message data"
+// @Success 200 {object} gin.H "success"
+// @Failure 400 {object} gin.H "Error on validation"
+// @Failure 500 {object} gin.H "Internal server error"
+// @Router /send/interactiveResponse [post]
+func (s *sendHandler) SendInteractiveResponse(ctx *gin.Context) {
+	getInstance := ctx.MustGet("instance")
+
+	instance, ok := getInstance.(*instance_model.Instance)
+	if !ok {
+		ctx.JSON(http.StatusInternalServerError, gin.H{"error": "instance not found"})
+		return
+	}
+
+	var data *send_service.InteractiveResponseStruct
+	err := ctx.ShouldBindBodyWithJSON(&data)
+	if err != nil {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
+		return
+	}
+
+	if data.Number == "" {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "phone number is required"})
+		return
+	}
+
+	if data.Name == "" {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "name is required"})
+		return
+	}
+
+	if data.ParamsJSON == "" {
+		ctx.JSON(http.StatusBadRequest, gin.H{"error": "paramsJSON is required"})
+		return
+	}
+
+	message, err := s.sendMessageService.SendInteractiveResponse(data, instance)
+	if err != nil {
+		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
+		return
+	}
+
+	ctx.JSON(http.StatusOK, gin.H{"message": "success", "data": message})
+}
+
 func NewSendHandler(
 	sendMessageService send_service.SendService,
 ) SendHandler {
