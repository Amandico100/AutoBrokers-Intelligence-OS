--- /dev/null
+++ b/pkg/sendMessage/service/interactive_response_test.go
@@ -0,0 +1,96 @@
+package send_service
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+// A unica captura real que temos de uma pessoa respondendo este formulario:
+// familia HDI, 18/07/2026. Telefones trocados por numeros de exemplo. Todo o
+// resto e literal -- inclusive a ORDEM das chaves e os acentos, que sao
+// exatamente as duas coisas que este teste existe para proteger.
+const cliqueHumanoParams = `{"rb_EmGaragemOuEstacionamento":"1","rb_NivelDaRua":"4","ckb_SituacoesVeiculo":["nenhuma_opcoes"],"rb_InformacoesLocal":"6","rb_Ocupantes":"1","flow_token":"00000000-0000-0000-0000-000000000000:551100000000:5500000000000","wa_flow_response_params":{"title":"Informar condicoes","flow_id":"857030507196739","flow_name":"Automovel - Detalhes do atendimento (veiculo, local e ocupantes) V2"}}`
+
+func TestRespostaDeFlowSaiIgualAoCliqueHumano(t *testing.T) {
+	msg, err := buildInteractiveResponseMessage(&InteractiveResponseStruct{
+		Number:     "5511999999999",
+		Name:       "galaxy_message",
+		ParamsJSON: cliqueHumanoParams,
+	})
+	if err != nil {
+		t.Fatalf("nao montou: %v", err)
+	}
+
+	nf := msg.GetInteractiveResponseMessage().GetNativeFlowResponseMessage()
+	if nf == nil {
+		t.Fatal("nativeFlowResponseMessage ausente -- o oneof nao foi preenchido")
+	}
+
+	if nf.GetName() != "galaxy_message" {
+		t.Errorf("envelope: quero galaxy_message, veio %q", nf.GetName())
+	}
+
+	// Byte a byte. Se algum dia alguem "arrumar" isto com um Unmarshal seguido
+	// de Marshal, as chaves trocam de ordem -- e este teste e o unico lugar onde
+	// isso aparece antes da seguradora.
+	if nf.GetParamsJSON() != cliqueHumanoParams {
+		t.Errorf("paramsJSON foi reescrito no caminho.\n quero: %s\n veio:  %s", cliqueHumanoParams, nf.GetParamsJSON())
+	}
+
+	// Ausente na captura -> ausente no que enviamos.
+	if nf.Version != nil {
+		t.Errorf("version deveria estar AUSENTE quando ninguem pediu, veio %d", nf.GetVersion())
+	}
+
+	if msg.GetInteractiveResponseMessage().GetBody() != nil {
+		t.Error("body deveria estar ausente quando nao foi pedido")
+	}
+}
+
+func TestVersionSoViajaQuandoAlguemPede(t *testing.T) {
+	msg, err := buildInteractiveResponseMessage(&InteractiveResponseStruct{
+		Name:       "flow",
+		ParamsJSON: `{"flow_token":"x"}`,
+		Version:    3,
+	})
+	if err != nil {
+		t.Fatalf("nao montou: %v", err)
+	}
+	if v := msg.GetInteractiveResponseMessage().GetNativeFlowResponseMessage().GetVersion(); v != 3 {
+		t.Errorf("version: quero 3, veio %d", v)
+	}
+}
+
+func TestRecusaOQueNaoPodeAdivinhar(t *testing.T) {
+	casos := []struct {
+		nome string
+		data *InteractiveResponseStruct
+	}{
+		{"sem o nome do envelope", &InteractiveResponseStruct{ParamsJSON: `{"a":1}`}},
+		{"sem paramsJSON", &InteractiveResponseStruct{Name: "galaxy_message"}},
+		{"paramsJSON que nao e JSON", &InteractiveResponseStruct{Name: "galaxy_message", ParamsJSON: "nao sou json"}},
+	}
+	for _, caso := range casos {
+		if _, err := buildInteractiveResponseMessage(caso.data); err == nil {
+			t.Errorf("%s: deveria ter recusado, e aceitou", caso.nome)
+		}
+	}
+}
+
+// Prova que o teste de cima nao passa por acidente: um paramsJSON reescrito por
+// Unmarshal+Marshal REALMENTE difere do original. Sem esta linha, a comparacao
+// byte a byte poderia estar comparando duas coisas iguais por coincidencia, e
+// um guarda que nao tem como falhar nao esta guardando nada.
+func TestAComparacaoByteAByteTemComoFalhar(t *testing.T) {
+	var qualquer map[string]interface{}
+	if err := json.Unmarshal([]byte(cliqueHumanoParams), &qualquer); err != nil {
+		t.Fatalf("a captura nao e JSON valido: %v", err)
+	}
+	reescrito, err := json.Marshal(qualquer)
+	if err != nil {
+		t.Fatalf("nao remarshalou: %v", err)
+	}
+	if string(reescrito) == cliqueHumanoParams {
+		t.Fatal("remarshal devolveu texto identico -- entao o teste de bytes nao prova nada")
+	}
+}
