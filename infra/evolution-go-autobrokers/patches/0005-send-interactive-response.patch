+// buildInteractiveResponseMessage assembles the answer, and touches nothing
+// else. It is a free function on purpose: the part of this feature that can
+// actually be WRONG is the encoding, and the encoding must be provable without
+// a phone, a pairing or a network. Everything that needs a live client stays in
+// the method below; everything that needs only correctness lives here, where a
+// test can reach it. See interactive_response_test.go.
+//
+// It is also deliberately incurious about the payload. This layer does not know
+// what a CEP is, which insurer is on the other end, or what the form asked. It
+// checks that ParamsJSON is JSON and carries it through untouched. When we
+// later learn some other field is required, that is a change in the caller --
+// not another image to build and roll out.
+func buildInteractiveResponseMessage(data *InteractiveResponseStruct) (*waE2E.Message, error) {
+	if data.Name == "" {
+		return nil, errors.New("name is required: echo it from the flow message being answered, never guess it")
+	}
+
+	if data.ParamsJSON == "" {
+		return nil, errors.New("paramsJSON is required")
+	}
+
+	// json.Valid READS. It does not rewrite, reorder or re-escape -- which is
+	// exactly why it is the only inspection this payload gets.
+	if !json.Valid([]byte(data.ParamsJSON)) {
+		return nil, errors.New("paramsJSON is not valid JSON")
+	}
+
+	nativeFlowResponse := &waE2E.InteractiveResponseMessage_NativeFlowResponseMessage{
+		Name:       proto.String(data.Name),
+		ParamsJSON: proto.String(data.ParamsJSON),
+	}
+
+	// Absent stays absent. The one captured instance of a human answering this
+	// flow carries no version at all, so defaulting it would put a number on the
+	// wire that no one ever observed.
+	if data.Version != 0 {
+		nativeFlowResponse.Version = proto.Int32(data.Version)
+	}
+
+	interactiveResponse := &waE2E.InteractiveResponseMessage{
+		InteractiveResponseMessage: &waE2E.InteractiveResponseMessage_NativeFlowResponseMessage_{
+			NativeFlowResponseMessage: nativeFlowResponse,
+		},
+	}
+
+	if data.Body != "" {
+		interactiveResponse.Body = &waE2E.InteractiveResponseMessage_Body{
+			Text:   proto.String(data.Body),
+			Format: waE2E.InteractiveResponseMessage_Body_DEFAULT.Enum(),
+		}
+	}
+
+	return &waE2E.Message{
+		InteractiveResponseMessage: interactiveResponse,
+	}, nil
+}
+
+// SendInteractiveResponse answers a native flow -- the message a person's phone
+// produces after filling in the form and tapping submit.
+func (s *sendService) SendInteractiveResponse(data *InteractiveResponseStruct, instance *instance_model.Instance) (*MessageSendStruct, error) {
+	if _, err := s.ensureClientConnected(instance.Id); err != nil {
+		return nil, err
+	}
+
+	msg, err := buildInteractiveResponseMessage(data)
+	if err != nil {
+		return nil, err
+	}
+
+	sendData := &SendDataStruct{
+		Number:    data.Number,
+		Delay:     data.Delay,
+		FormatJid: data.FormatJid,
+		Quoted:    data.Quoted,
+	}
+
+	if data.WithBizNodes {
+		bizNodes := []waBinary.Node{
+			{
+				Tag: "biz",
+				Content: []waBinary.Node{{
+					Tag: "interactive",
+					Attrs: waBinary.Attrs{
+						"type": "native_flow",
+						"v":    "1",
+					},
+					Content: []waBinary.Node{{
+						Tag:   "native_flow",
+						Attrs: waBinary.Attrs{"name": data.Name},
+					}},
+				}},
+			},
+		}
+		if !strings.Contains(data.Number, "@g.us") {
+			bizNodes = append(bizNodes, waBinary.Node{
+				Tag:   "bot",
+				Attrs: waBinary.Attrs{"biz_bot": "1"},
+			})
+		}
+		sendData.AdditionalNodes = &bizNodes
+	}
+
+	message, err := s.SendMessage(instance, msg, "InteractiveResponseMessage", sendData)
+	if err != nil {
+		s.loggerWrapper.GetLogger(instance.Id).LogError("[%s] Error sending interactive response: %v", instance.Id, err)
+		return nil, err
+	}
+
+	return message, nil
+}
