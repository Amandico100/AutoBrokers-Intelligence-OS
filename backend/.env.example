DRY_RUN=False

# =============================================================================
# ATENDIMENTO — as chaves que decidem se algo SAI de verdade   (SPEC-063 §H.3)
# =============================================================================
# Nenhuma destas estava aqui. Dez variáveis governando envio real, aprovação e
# destilação, invisíveis para quem clonasse o repositório — e três delas estão
# LIGADAS em produção sem registro em documento nenhum.
#
# A regra: variável que decide se uma mensagem chega a um segurado ou a uma
# seguradora mora aqui, com o padrão seguro escrito ao lado.

# --- Porta de entrada -------------------------------------------------------
# disabled | shared_secret | provider_signature
# `disabled` faz a rota legada /webhook/z-api resolver o TENANT pelo
# `connectedPhone` do CORPO — que é forjável. O padrão do código passou a ser
# shared_secret (nasce fechado). Só abra em desenvolvimento, de propósito.
WHATSAPP_WEBHOOK_AUTH_MODE=shared_secret
WHATSAPP_WEBHOOK_SECRET=

# Quem pode falar com o agente de atendimento. Vazio = TODOS.
# Enquanto o atendimento não passar pelo gate de go-live, mantenha uma lista.
ATTENDANT_INBOUND_ALLOWLIST=

# --- Acionamento da seguradora ----------------------------------------------
# O INTERRUPTOR É UM SÓ, e não mora aqui: é `agents.is_active` do agente de
# atendimento da corretora (o botão LIGAR AGENTE). Decisão do Founder,
# 04/08/2026, dita duas vezes — "tudo pronto e funcionando, mas o agente tem
# que continuar desligado; só pode funcionar se clicar em LIGAR AGENTE".
# Com o agente desligado, NADA sai: nem para o segurado, nem para a seguradora,
# nem para o portal de vidros. Trava sobre trava não protege mais, esconde.
#
# O FREIO DE EMERGÊNCIA. Uma linha, sem deploy, derruba os DOIS corredores
# (portal de vidros E WhatsApp da seguradora) mesmo com o agente ligado.
# Vazio/ausente = solto. Só um "sim" explícito arma.
ACIONAMENTO_FREIO_DE_EMERGENCIA=

# O PORTÃO DE ENVIO REAL (S17-6). Ausente = ABERTO desde 04/08/2026 — o que
# segura é o agente desligado. `false` continua fechando de propósito, e um
# `false` herdado do exemplo antigo faz o acionamento NÃO sair nem com o agente
# ligado. Se ligar o agente e nada acontecer, é esta linha.
INSURER_DISPATCH_LIVE=

# O FREIO DE FINALIZAÇÃO (decisão do Founder, 11/07/2026; padrão invertido em
# 04/08/2026).
# live (padrão) = os corredores completam ponta a ponta, sem humano.
# test = ao detectar o passo em que a URA vai CONFIRMAR/ABRIR o serviço, o motor
#        CANCELA e vai para `test_aborted`. Nada é aberto.
# Para graduar um corredor de cada vez, escreva `test` e liste os validados em
# DISPATCH_FINALIZE_LIVE_PLAYBOOKS (ex.: allianz-auto-whatsapp@v1).
# ⚠️ Meio aberto é pior que fechado: com o envio liberado e a finalização em
# `test`, mensagens REAIS chegam à URA e o pedido é cancelado no fim — o
# segurado ouviu "estou acionando" e ninguém vem.
DISPATCH_FINALIZE_MODE=live
DISPATCH_FINALIZE_LIVE_PLAYBOOKS=

# De quantos em quantos minutos a verdade durável (Work Runs em voo) é comparada
# com o cache. É o que descobre o acionamento ÓRFÃO — aquele cuja sessão sumiu do
# Redis com o segurado ainda esperando. Antes dela ser periódica, a varredura
# rodava 1x por processo E dependia de tráfego: sem mensagem nova, o cache-miss
# nunca acontecia e o órfão ficava em silêncio.
DISPATCH_RECONCILE_INTERVAL_MINUTES=5

# O Cartógrafo ENVIA WhatsApp REAL para seguradoras para mapear a URA delas.
# 0 = desligado.
CARTOGRAPHER_MODE=0

# --- Conhecimento e contexto ------------------------------------------------
# shadow = o plano de contexto é calculado, logado e DESCARTADO.
# on     = o plano passa a escolher as fontes por intenção.
CONTEXT_ASSEMBLY_MODE=shadow

# Teto de chamadas de modelo por rodada do destilador. 0 = nenhuma carta nova é
# destilada (curadoria e publicação seguem normalmente).
DESTILADOR_TETO_POR_RODADA=0

# Quantas mensagens do histórico entram no turno. Abaixo de 60 o agente já
# repetiu pergunta que o cliente tinha respondido.
CHAT_HISTORY_WINDOW=60

# A rota que responde um FORMULÁRIO NATIVO (WhatsApp Flow) da seguradora.
#
# 📊 Medido em 03/08/2026: o build atual do Evolution GO tem 88 rotas, doze de
# envio, e NENHUMA envia resposta de interativa. Enquanto esta variável estiver
# vazia, o motor monta a resposta certa, NÃO tenta a rede, e pausa com a
# resposta pronta no dossiê — o humano marca em 10 segundos.
#
# Preencher só quando existir a rota de verdade. Chave vazia é o padrão seguro.
EVOLUTION_GO_FLOW_REPLY_PATH=
