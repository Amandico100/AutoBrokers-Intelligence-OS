# =============================================
# Auth (deve ser igual ao DOCLING_SERVICE_KEY do Smith)
# =============================================
SERVICE_KEY=sua-chave-secreta-aqui

# =============================================
# Ambiente: 'production' (estrito) | 'local'/'dev'/'test' (permite localhost)
# =============================================
ENV=production

# =============================================
# Redis (broker + result do Celery) — FONTE ÚNICA. Defina a MESMA URL na API E no WORKER.
# Em produção NÃO pode ser localhost (o serviço falha no startup com mensagem clara).
# Ex.: redis://default:SENHA@nome-do-servico-redis:6379/0
# =============================================
REDIS_URL=

# =============================================
# MinIO (mesma instância do Agent Smith)
# =============================================
MINIO_ENDPOINT=host.docker.internal:9000   # Dev local (Docker Desktop)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
MINIO_SECURE=false

# =============================================
# Vision LLM (descrição de imagens)
# =============================================
VISION_MODEL=gpt-4o-mini
VISION_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=sk-proj-xxxxxxxx

# =============================================
# OCR
# =============================================
OCR_ENGINE=easyocr

# =============================================
# Limites
# =============================================
MAX_FILE_SIZE_MB=100
RESULT_TTL_SECONDS=3600

# =============================================
# Server
# =============================================
PORT=8001
